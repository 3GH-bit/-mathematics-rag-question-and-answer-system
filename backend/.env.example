# ===== 数学家教助手（chat_rag.py）必需：DeepSeek Key =====
# 把本文件复制为 backend/.env，填入你的 Key（不要提交 .env）
DEEPSEEK_API_KEY=sk-你的key

# ===== 以下为原始 FastAPI RAG 应用的可选配置 =====
# Скопируйте в backend/.env и заполните при необходимости.
# Без ключей приложение работает в демо-режиме (mock) + локальные эмбеддинги.

# --- LLM провайдеры (все опциональны) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_GPU=0   # форсировать CPU для Ollama (нужно на macOS 13 / Ventura,
#                    # где Metal-сборка падает с GGML_ASSERT)

# --- Эмбеддинги: "local" (по умолчанию, офлайн) или "openai" ---
# EMBEDDING_PROVIDER=local

# --- Ретривал ---
# RETRIEVAL_TOP_K=5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# SEARCH_HYBRID=1    # BM25 + вектора через RRF (включён по умолчанию)
# SEARCH_RERANK=0    # cross-encoder реранк (fastembed bge-reranker-base, ~1 ГБ)
# RETRIEVAL_CANDIDATES=20
# ZAI_THINKING=disabled  # GLM-4.x: disabled|enabled; GLM-5.x: low|high|max
                        # (5.x всегда думают — disabled превращается в low)
